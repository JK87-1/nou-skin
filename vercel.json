{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "crons": [
    {
      "path": "/api/healthcheck",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/push-send",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/push-tips",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/push-send?test=1",
      "schedule": "50 5 * * *"
    }
  ]
}
